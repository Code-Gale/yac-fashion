# ─── APP ───────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3025
# Production CORS: CLIENT_URL must match the shop origin exactly (https, no trailing slash).
# Optional extra origins (comma-separated), e.g. https://www.yourshop.com
# ALLOWED_ORIGINS=

# ─── DATABASE ──────────────────────────────────
MONGO_URI=mongodb://localhost:27401/yac-fashion
MONGO_USER=yacuser
MONGO_PASSWORD=changeme_mongo_password

# ─── REDIS ─────────────────────────────────────
REDIS_URL=redis://localhost:16379
REDIS_PASSWORD=changeme_redis_password

# ─── JWT ───────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── NODEMAILER (GMAIL) ────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=YAC Fashion House
MAIL_FROM_ADDRESS=

# ─── MINIO ─────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=19000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=yac-images
MINIO_PUBLIC_URL=http://localhost:19000/yac-images

# ─── PAYMENTS ──────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# ─── FRONTEND (NEXT.JS PUBLIC) ─────────────────
NEXT_PUBLIC_API_URL=http://localhost:5401
# Server-side fetches only (Next SSR → API). In Docker Compose use the API service URL:
# INTERNAL_API_URL=http://api:4000
INTERNAL_API_URL=http://localhost:4000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GTM_ID=

# ─── ADMIN ─────────────────────────────────────
ADMIN_EMAIL=admin@yacfashion.com
ADMIN_INITIAL_PASSWORD=Admin@123
