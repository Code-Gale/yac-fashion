# ─── APP ───────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3025
# Production CORS: CLIENT_URL must match the shop origin exactly (https, no trailing slash).
# Optional extra origins (comma-separated), e.g. https://www.yourshop.com
# ALLOWED_ORIGINS=

# ─── DATABASE ──────────────────────────────────
MONGO_URI=mongodb://localhost:27401/yac-fashion
MONGO_USER=yacuser
MONGO_PASSWORD=changeme_mongo_password

# ─── REDIS ─────────────────────────────────────
REDIS_URL=redis://localhost:16379
REDIS_PASSWORD=changeme_redis_password

# ─── JWT ───────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── NODEMAILER (GMAIL) ────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=YAC Fashion House
MAIL_FROM_ADDRESS=

# ─── MINIO ─────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=19000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=yac-images
# Public URL for uploaded images. In production defaults to {CLIENT_URL}/api/files if unset.
# Example: https://yacfashionhouse.com/api/files
MINIO_PUBLIC_URL=

# ─── PAYMENTS ──────────────────────────────────
# Paystack dashboard > Settings > API Keys & Webhooks.
# Webhook URL to configure there: {CLIENT_URL}/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Flutterwave dashboard > Settings > API. 
# Webhook URL to configure there: {CLIENT_URL}/api/payments/flutterwave/webhook
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Flutterwave dashboard > Settings > Webhooks > Secret Hash (recommended — do NOT reuse
# FLUTTERWAVE_SECRET_KEY here in production; a dedicated hash limits blast radius if leaked).
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# ─── FRONTEND (NEXT.JS PUBLIC) ─────────────────
# Public site origin OR API origin — with or without /api (both work).
# Production behind Nginx: use your canonical shop URL (https://yourdomain.com).
# The browser calls /api on whatever host the user opened (www or apex); this
# value is mainly for local dev and SSR fallbacks.
NEXT_PUBLIC_API_URL=http://localhost:5401
NEXT_PUBLIC_SITE_URL=http://localhost:3025
# SSR in Docker is set automatically in docker-compose.prod.yml (http://api:4000)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=2348067152368
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/yacfashionhouse/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/yacfashionhouse/
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@yacfashionhouse

# ─── ADMIN ─────────────────────────────────────
ADMIN_EMAIL=admin@yacfashion.com
ADMIN_INITIAL_PASSWORD=Admin@123
